# Copy this file to `.env` and fill in your key. Never commit `.env`.

# --- OpenRouter (default) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_FALLBACK_MODEL=meta-llama/llama-3.1-8b-instruct

# --- Using Groq (or any OpenAI-compatible provider) instead? ---
# Just override the base URL + model names. The backend speaks standard
# /chat/completions + SSE, so no code changes are needed.
# Example for Groq:
# OPENROUTER_API_KEY=gsk_...
# OPENROUTER_BASE_URL=https://api.groq.com/openai/v1
# OPENROUTER_MODEL=openai/gpt-oss-120b
# OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-20b
